{
  "title": "Service Golden Signals",
  "uid": "service-golden-signals",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate by Version",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{path=\"/work\"}[1m])) by (status)",
          "legendFormat": "status {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Success Rate by Version",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{path=\"/work\",status!~\"5..\"}[1m])) / sum(rate(http_requests_total{path=\"/work\"}[1m]))",
          "legendFormat": "success rate"
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 Latency by Version",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{path=\"/work\"}[1m])) by (le))",
          "legendFormat": "p95 latency (s)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Logs",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{app=\"demo-service\"}",
          "datasource": { "type": "loki", "uid": "loki" }
        }
      ]
    }
  ]
}
